{
  // Local only: `pnpm db:migrate:scan:local` applies scan-migrations to a
  // Miniflare D1 with this binding. Never deployed (wrangler.jsonc is the
  // deploy config and binds SCAN_DB only once the database exists).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "matchbox-jobs-scan-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "d1_databases": [
    {
      "binding": "SCAN_DB",
      "database_name": "matchbox-scan",
      "database_id": "local-only",
      "migrations_dir": "scan-migrations"
    }
  ]
}
