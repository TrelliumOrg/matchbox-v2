# Local secrets for `wrangler dev`. Copy to `.dev.vars` (git-ignored).
# Production values are set with `wrangler secret put <NAME>`.

# Supabase (service role; data store only). Not needed with PLATFORM_STORE=memory.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Same value as the developer console uses to issue keys (>= 32 random chars).
API_KEY_PEPPER=replace-with-at-least-32-random-characters

# Reconciliation cron RPC endpoints. Mainnet unset: the public Mezo RPCs
# (src/heads/poller.ts). A mainnet URL here goes first for every chain read,
# including live wallet builds (README, "Local read models").
# MEZO_MAINNET_RPC_URL=https://mezo-mainnet.boar.network
MEZO_TESTNET_RPC_URL=https://rpc.test.mezo.org

# Lets a direct caller (curl, Pro without a service binding) reach
# /internal/* with `Authorization: Bearer <INTERNAL_TOKEN>`. Binding callers
# need nothing. Leave unset in production.
# At least 32 characters; ignored when ENVIRONMENT=production.
# INTERNAL_TOKEN=replace-with-at-least-32-random-characters

# Blockscout proxy upstream key (optional; without one the proxy shares
# Blockscout's 300 requests per window per IP).
# BLOCKSCOUT_API_KEY=

# Local-only overrides (never set these in production).
ENVIRONMENT=development
GAUGE_PROFILE_API_ENABLED=true
# PLATFORM_STORE=memory

# Health cron targets (wrangler vars default to production). Blank skips a
# probe. Trigger locally: `wrangler dev --test-scheduled`, then
# curl "http://localhost:8787/__scheduled?cron=*+*+*+*+*"
HEALTH_API_URL=http://localhost:8787/v1/health
HEALTH_ID_URL=
