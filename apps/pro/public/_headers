# Static assets are served before the Worker runs: the same headers the
# Worker sets (app-kit security.ts), CSP aside, which only pages need.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()

# Safe{Wallet} (safe.mezo.org) reads the Safe App manifest cross-origin.
/manifest.json
  Access-Control-Allow-Origin: https://safe.mezo.org
  Access-Control-Allow-Methods: GET
  Access-Control-Allow-Headers: X-Requested-With, content-type, Authorization
  Vary: Origin
