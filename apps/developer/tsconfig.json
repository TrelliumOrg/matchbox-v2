{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "ES2023.Intl", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["@cloudflare/workers-types", "vite/client", "node"],
    "declaration": false,
    "declarationMap": false,
    "noEmit": true
  },
  // The pages. The console server (src/worker) and the Worker entry are
  // checked by tsconfig.worker.json, without the DOM lib: @matchbox/server's
  // WebCrypto calls do not typecheck against the DOM's BufferSource.
  "include": [
    "src/routes",
    "src/app",
    "src/lib",
    "src/router.tsx",
    "src/routeTree.gen.ts",
    "src/execution.server.ts",
    "e2e",
    "playwright.config.ts"
  ]
}
