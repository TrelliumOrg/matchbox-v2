{
  "name": "@matchbox/developer",
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 5175 --strictPort",
    "build": "vite build && node scripts/check-build-env.mjs CONSOLE_ORIGIN,ID_ORIGIN",
    "preview": "vite preview --port 5175 --strictPort",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "e2e": "playwright test --grep-invert @slow",
    "e2e:slow": "playwright test --grep @slow",
    "measure": "node ./scripts/measure.mjs"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource/dm-mono": "5.3.0",
    "@matchbox/app-kit": "workspace:*",
    "@matchbox/contracts": "workspace:*",
    "@matchbox/docs": "workspace:*",
    "@matchbox/feedback-ui": "workspace:*",
    "@matchbox/logger": "workspace:*",
    "@matchbox/motion": "workspace:*",
    "@matchbox/server": "workspace:*",
    "@matchbox/tokens": "workspace:*",
    "@matchbox/ui": "workspace:*",
    "@supabase/supabase-js": "2.108.2",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.5",
    "hono": "4.13.5",
    "jose": "6.1.2",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@cloudflare/workers-types": "5.20261108.1",
    "@matchbox/perf": "workspace:*",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "happy-dom": "21.0.4",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "4.1.12",
    "wrangler": "4.158.0"
  }
}
