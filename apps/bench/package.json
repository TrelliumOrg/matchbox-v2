{
  "name": "@matchbox/bench",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite dev --port 3007",
    "build": "vite build && node ./scripts/postbuild.mjs",
    "preview": "vite preview --port 4203 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "measure": "node ./scripts/measure.mjs",
    "lhci": "matchbox-lhci --config=./lighthouserc.cjs"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource/dm-mono": "5.3.0",
    "@matchbox/app-kit": "workspace:*",
    "@matchbox/tokens": "workspace:*",
    "@matchbox/ui": "workspace:*",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@cloudflare/workers-types": "5.20261108.1",
    "@lhci/cli": "0.16.0",
    "@matchbox/contracts": "workspace:*",
    "@matchbox/perf": "workspace:*",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "axe-core": "4.14.0",
    "happy-dom": "21.0.4",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "4.1.12",
    "wrangler": "4.158.0",
    "zod": "4.6.7"
  }
}
