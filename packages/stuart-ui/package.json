{
  "name": "@matchbox/stuart-ui",
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./contract": {
      "types": "./src/contract.ts",
      "default": "./src/contract.ts"
    },
    "./launcher": {
      "types": "./src/launcher.tsx",
      "default": "./src/launcher.tsx"
    },
    "./store": {
      "types": "./src/api.ts",
      "default": "./src/api.ts"
    },
    "./panel": {
      "types": "./src/panel.tsx",
      "default": "./src/panel.tsx"
    },
    "./commands": {
      "types": "./src/commands.ts",
      "default": "./src/commands.ts"
    },
    "./paste": {
      "types": "./src/paste.ts",
      "default": "./src/paste.ts"
    },
    "./search": {
      "types": "./src/search.tsx",
      "default": "./src/search.tsx"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@matchbox/contracts": "workspace:*",
    "@matchbox/motion": "workspace:*",
    "@matchbox/token-icons": "workspace:*",
    "@matchbox/tokens": "workspace:*",
    "@matchbox/ui": "workspace:*",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "21.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  }
}
