{
  "name": "@matchbox/motion",
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./haptics": {
      "types": "./src/haptics.ts",
      "default": "./src/haptics.ts"
    },
    "./page": {
      "types": "./src/page-motion.ts",
      "default": "./src/page-motion.ts"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "default": "./src/testing.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@number-flow/react": "0.6.2",
    "number-flow": "0.6.2",
    "skullet": "0.0.3",
    "torph": "0.1.3",
    "web-haptics": "0.0.6"
  },
  "peerDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "21.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  }
}
