{
  "name": "matchbox-v2",
  "license": "AGPL-3.0-only",
  "private": true,
  "packageManager": "pnpm@9.14.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check . && prettier --check \"**/*.{json,yaml,yml,md}\"",
    "lint:fix": "biome check --write . && prettier --write \"**/*.{json,yaml,yml,md}\"",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:trellium": "node scripts/check-trellium-boundary.mjs",
    "test:scripts": "node --test \"scripts/lib/*.test.mjs\"",
    "release:trellium:prepare": "node scripts/prepare-trellium-release.mjs",
    "release:trellium:publish": "node scripts/publish-trellium-release.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "prettier": "^3.4.1",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2"
  }
}
